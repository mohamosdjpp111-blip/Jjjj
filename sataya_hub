local function ResolveAndLoadKey(keyStr, hooks)
 hooks = hooks or {}
 local onStatus = hooks.onStatus or function() end
 local onSuccess = hooks.onSuccess or function() end
 local onFail = hooks.onFail or function() end

 keyStr = keyStr and tostring(keyStr):gsub("%s+", "") or ""
 if keyStr == "" then
 onFail("empty")
 return
 end

 local startTime = os.clock()
 onStatus("جاري التحقق من مفتاح ساتايا...")

 -- التحقق مما إذا كان الكود موجوداً ضمن الأكواد الـ 50 العشوائية
 local isValid = false
 for _, k in ipairs(VALID_KEYS) do
     if k == keyStr then
         isValid = true
         break
     end
 end

 task.wait(0.5) -- محاكاة سرعة التحقق

 if not isValid then
 ClearKey()
 onFail("KEY_INVALID", "المفتاح غير صحيح")
 return
 end

 local elapsedStr = string.format("%.2fs", os.clock() - startTime)

 SaveKey(keyStr)
 getgenv().script_key = keyStr
 getgenv().key = keyStr
 getgenv().key_expire = 0
 getgenv().key_note = "مفتاح ساتايا نشط"
 getgenv().key_executions = 1

 onStatus("المفتاح صحيح! جارٍ التشغيل...")

 onSuccess({
 permanent = true,
 expire = 0,
 elapsedStr = elapsedStr,
 })

 LoadStockLoader()
end

